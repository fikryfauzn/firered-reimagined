    "MOVE_ACID": {
      "decision": "KEEP",
      "approved_cost": 2,
      "reasoning": [
        "Modern secondary changes from Defense drop to SpDef drop.",
        "40 BP and 10 percent secondary chance remain low-pressure.",
        "Modernization does not materially change its Stamina tier."
      ]
    },
    "MOVE_GROWTH": {
      "decision": "CHANGE",
      "approved_cost": 4,
      "reasoning": [
        "Modern Growth raises both Attack and SpAtk rather than only SpAtk.",
        "The move now supports physical, special, and mixed setup.",
        "Broader guaranteed setup value warrants moving from cost 3 to 4."
      ]
    },
    "MOVE_STRING_SHOT": {
      "decision": "CHANGE",
      "approved_cost": 4,
      "reasoning": [
        "Modern String Shot lowers Speed by two stages rather than one.",
        "The stronger deterministic tempo swing materially increases tactical value.",
        "Raise from cost 3 to 4."
      ]
    },
    "MOVE_SWEET_SCENT": {
      "decision": "KEEP",
      "approved_cost": 3,
      "reasoning": [
        "Modern Sweet Scent lowers Evasion by two stages rather than one.",
        "The effect is stronger but remains indirect and situational.",
        "Cost 3 remains sufficient."
      ]
    },
    "MOVE_CRUNCH": {
      "decision": "KEEP",
      "approved_cost": 3,
      "reasoning": [
        "Modern Crunch lowers Defense rather than SpDef.",
        "The new secondary synergizes better with its physical damage.",
        "The 20 percent trigger is not sufficient to move an 80 BP move into cost 4."
      ]
    },
    "MOVE_NEEDLE_ARM": {
      "decision": "KEEP",
      "approved_cost": 3,
      "reasoning": [
